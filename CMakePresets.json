{
    "version": 3,
    "configurePresets": [
        {
            "name": "linux-ninja-debug",
            "description": "Compiling and debugging projects using Linux Ninja.",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/novainfra",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "linux-ninja-release",
            "description": "Compiling a release project using Linux Ninja.",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/novainfra",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "build-linux-ninja-debug",
            "configurePreset": "linux-ninja-debug",
            "jobs": 3
        },
        {
            "name": "build-linux-ninja-release",
            "configurePreset": "linux-ninja-release",
            "jobs": 3
        }
    ]
}